<?xml version="1.0"?>
<ruleset name="Order Window (Free)">
    <description>The root ruleset, with Free's own text domain only (OW-054). phpcs picks this file when run from this folder.</description>

    <rule ref="../../phpcs.xml.dist"/>

    <!-- The root ruleset's <file> covers both plugins; Pro keeps the root's two domains. -->
    <exclude-pattern>*/plugins/orderwindow-pro/*</exclude-pattern>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="orderwindow"/>
            </property>
        </properties>
    </rule>
</ruleset>
