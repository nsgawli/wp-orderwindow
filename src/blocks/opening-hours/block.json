{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "orderwindow/opening-hours",
	"title": "Opening hours",
	"category": "woocommerce",
	"description": "Shows the store’s weekly opening hours, with today highlighted.",
	"keywords": ["hours", "open", "schedule", "order window"],
	"textdomain": "orderwindow",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"showClosures": { "type": "boolean", "default": false }
	},
	"supports": { "html": false }
}
